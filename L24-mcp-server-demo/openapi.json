{"openapi":"3.0.1","info":{"title":"OpenAPI definition","version":"v0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Admin APIs","description":"Endpoints for company, seller and category administration"},{"name":"Customer APIs","description":"Endpoints for product browsing and order lifecycle actions"},{"name":"Seller APIs","description":"Endpoints for seller operations like product management and order processing"}],"paths":{"/api/seller/products/{productId}":{"put":{"tags":["Seller APIs"],"summary":"Update product","description":"Updates an existing product by product id.","operationId":"updateProduct","parameters":[{"name":"productId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateProductRequestDto"}}},"required":true},"responses":{"400":{"description":"Validation error"},"200":{"description":"Product updated successfully"},"404":{"description":"Product, company, or category not found"}}}},"/api/seller/orders/{orderId}/accept":{"put":{"tags":["Seller APIs"],"summary":"Accept order","description":"Changes order status from PLACED to ACCEPTED.","operationId":"acceptOrder","parameters":[{"name":"orderId","in":"path","description":"Order id","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"404":{"description":"Order not found"},"200":{"description":"Order accepted successfully"},"400":{"description":"Order is not in PLACED status"}}}},"/api/customer/order/{id}/submit":{"put":{"tags":["Customer APIs"],"summary":"Submit order","description":"Changes order status from DRAFT to PLACED.","operationId":"submitOrder","parameters":[{"name":"id","in":"path","description":"Order id","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"400":{"description":"Order is not in DRAFT status"},"404":{"description":"Order not found"},"200":{"description":"Order subm